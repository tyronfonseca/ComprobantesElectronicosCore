# Credenciales del API de Recepción de Comprobantes Electrónicos (scripts/enviar_comprobante.py).
# Copie este archivo a .env y complete los valores. El .env no se sube al repositorio.

# Usuario y contraseña generados en ATV (Comprobantes Electrónicos > generación de contraseña)
HACIENDA_USUARIO=cpj-3-101-000000@stag.comprobanteselectronicos.go.cr
HACIENDA_CLAVE=

# sandbox (api-sandbox + realm rut-stag) o produccion (api + realm rut)
HACIENDA_AMBIENTE=sandbox

# Opcional: URL donde Hacienda envía la respuesta (POST application/json)
HACIENDA_CALLBACK_URL=

# Archivo de certificados raíz para HTTPS; solo si falla la verificación del certificado.
# HACIENDA_CA_BUNDLE=/ruta/cacert.pem
